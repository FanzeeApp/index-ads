# ─── Telegram ───────────────────────────────────────────────
# @BotFather dan olingan token. HECH QACHON kodga yozmang.
BOT_TOKEN=123456:ABC-DEF...
BOT_USERNAME=my_ads_bot

# polling | webhook  (Railway uchun webhook tavsiya etiladi)
BOT_MODE=webhook
# Railway public domain, masalan: https://ads-bot-production.up.railway.app
PUBLIC_URL=https://example.up.railway.app
# Webhook yo'lini himoyalash uchun tasodifiy maxfiy satr (32+ belgi)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── Ma'lumotlar bazasi ─────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ─── Server ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# ─── Adminlar ───────────────────────────────────────────────
# Vergul bilan ajratilgan Telegram ID lar. Birinchisi — SUPERADMIN.
SUPER_ADMIN_IDS=123456789

# ─── Fotolar arxivi ─────────────────────────────────────────
# Yopiq kanal/guruh ID si (bot admin bo'lishi shart). Rasm fayllari
# shu yerda saqlanadi — Railway disk vaqtinchalik bo'lgani uchun.
ARCHIVE_CHAT_ID=-1001234567890

# ─── Biznes qoidalari ───────────────────────────────────────
# Tekshiruv davriyligi (kun)
CHECK_INTERVAL_DAYS=3
# Haydovchiga beriladigan muddat (soat)
CHECK_DEADLINE_HOURS=24
# Eslatmalar (soatlarda, muddat boshlanishidan)
CHECK_REMINDER_HOURS=6,18
# EXIF/GPS tekshiruvi qat'iyligi: strict | lenient | off
PHOTO_VALIDATION_MODE=lenient
# Rasm EXIF vaqti shu daqiqadan eski bo'lsa — rad etiladi
PHOTO_MAX_AGE_MINUTES=120
